<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Rufux</vendor>
  <vendor_url>https://github.com/oreo1298/WindowsUSBLinux</vendor_url>
  <icon_name>io.github.oreo1298.Rufux</icon_name>

  <action id="io.github.oreo1298.rufux.helper">
    <description>Format and write a USB drive or SD card</description>
    <message>Authentication is required to format and write to a removable drive</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
  </action>
</policyconfig>
